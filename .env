APP_NAME="RankTracker"
APP_ENV=local
APP_KEY=base64:gjuBloJ0oLb52VCbWGz9AmLDmpegKUMamT4gn3VDEzY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seoranktracker
DB_USERNAME=root
DB_PASSWORD=

# ─── Queue ────────────────────────────────────────────────
# Use "sync" for immediate (no queue worker needed during dev)
# Use "database" or "redis" in production
QUEUE_CONNECTION=sync

# ─── Cache ────────────────────────────────────────────────
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ─── Mail (for rank-drop alerts) ──────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your@gmail.com
MAIL_FROM_NAME="RankTracker"

# ─── SERP API ─────────────────────────────────────────────
# Supported providers: serper | serpapi | dataforseo
# Admin can also change this from the UI (stored in DB, takes priority)
SERP_PROVIDER=serper
SERP_API_KEY=39a04a35f3948d9ad44d0d5f1697b72ca8cc2881
SERP_COUNTRY=in
SERP_LANGUAGE=en
SERP_RESULTS=100

# Time to run the daily rank check (24h format, server timezone)
SERP_SCHEDULE_TIME=16:25

# DataForSEO only — leave blank if using serper or serpapi
DATAFORSEO_LOGIN=